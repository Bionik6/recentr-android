    <string name="hold_service_summary">Puts the apps your rules and focus sessions block on hold.</string>
    <string name="hold_service_description">Recentr puts the apps blocked by your rules and focus sessions on hold. It only sees which app you open — never what’s on your screen — and nothing leaves your phone.</string>

