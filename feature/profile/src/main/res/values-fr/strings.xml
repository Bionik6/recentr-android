    <!-- 67 · Settings — Help & feedback -->
    <string name="help_title">Aide et commentaires</string>
    <string name="help_subtitle">On lit chaque message.</string>
    <string name="help_not_blocking">Recentr ne bloque pas une appli</string>
    <string name="help_not_blocking_body">Le blocage nécessite l’accès aux données d’utilisation et que Recentr tourne en arrière-plan. Vérifie Paramètres › Applis › Recentr et désactive l’optimisation de la batterie.</string>
    <string name="help_strict">Questions sur le Mode strict</string>
    <string name="help_strict_body">Active le Mode strict pour une session ou une routine et, jusqu’à sa fin, ses applis ne peuvent plus être déverrouillées, sauf avec un déverrouillage d’urgence. Le désactiver n’est alors possible qu’à la fin. Paramètres › Mode strict l’active pour toutes les nouvelles.</string>
    <string name="help_billing">Facturation et Recentr Plus</string>
    <string name="help_billing_body">Recentr Plus est facturé via Google Play. Tu peux résilier à tout moment depuis Paramètres › Recentr Plus ou tes abonnements Play.</string>
