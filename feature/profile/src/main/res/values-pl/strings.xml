    <!-- 67 · Settings — Help & feedback -->
    <string name="help_title">Pomoc i opinie</string>
    <string name="help_subtitle">Czytamy każdą wiadomość.</string>
    <string name="help_not_blocking">Recentr nie blokuje aplikacji</string>
    <string name="help_not_blocking_body">Blokowanie wymaga dostępu do danych o użyciu i działania Recentr w tle. Sprawdź Ustawienia › Aplikacje › Recentr i wyłącz optymalizację baterii.</string>
    <string name="help_strict">Pytania o tryb ścisły</string>
    <string name="help_strict_body">Włącz tryb ścisły dla sesji lub rutyny, a do jej końca aplikacji nie da się odblokować inaczej niż awaryjnym odblokowaniem. Jego wyłączenie czeka wtedy do końca. Ustawienia › Tryb ścisły włącza go dla każdej nowej.</string>
    <string name="help_billing">Płatności i Recentr Plus</string>
    <string name="help_billing_body">Recentr Plus jest rozliczany przez Google Play. Możesz anulować w dowolnej chwili w Ustawienia › Recentr Plus lub w swoich subskrypcjach Play.</string>
