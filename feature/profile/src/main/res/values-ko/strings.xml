    <!-- 67 · Settings — Help & feedback -->
    <string name="help_title">도움말 및 의견</string>
    <string name="help_subtitle">모든 메시지를 읽고 있어요.</string>
    <string name="help_not_blocking">Recentr가 앱을 차단하지 않아요</string>
    <string name="help_not_blocking_body">차단하려면 사용 정보 접근 권한이 필요하고 Recentr가 백그라운드에서 실행 중이어야 해요. 설정 › 앱 › Recentr에서 확인하고 배터리 최적화를 꺼 주세요.</string>
    <string name="help_strict">엄격 모드 관련 질문</string>
    <string name="help_strict_body">세션이나 루틴에서 엄격 모드를 켜면 끝날 때까지 해당 앱은 긴급 잠금 해제 외에는 잠금 해제할 수 없어요. 끄는 것도 끝날 때까지 기다려야 해요. 설정 › 엄격 모드에서 새로 만드는 모든 항목에 켤 수 있어요.</string>
    <string name="help_billing">결제 &amp; Recentr Plus</string>
    <string name="help_billing_body">Recentr Plus는 Google Play로 결제돼요. 설정 › Recentr Plus 또는 Play 구독에서 언제든 해지할 수 있어요.</string>
    <string name="help_note_section">메모 보내기</string>
    <string name="help_note_title">Recentr 아이디어</string>
    <string name="help_note_placeholder">다 같이 함께 잠그는 “친구와 공부하기” 세션이 있으면 좋겠어요.</string>
