    <!-- 67 · Settings — Help & feedback -->
    <string name="help_title">सहायता और फ़ीडबैक</string>
    <string name="help_subtitle">हम हर संदेश पढ़ते हैं।</string>
    <string name="help_not_blocking">Recentr कोई ऐप ब्लॉक नहीं कर रहा</string>
    <string name="help_not_blocking_body">ब्लॉकिंग के लिए उपयोग एक्सेस और बैकग्राउंड में चलता Recentr ज़रूरी है। सेटिंग › ऐप्स › Recentr देखें और बैटरी ऑप्टिमाइज़ेशन बंद करें।</string>
    <string name="help_strict">सख़्त मोड के बारे में सवाल</string>
    <string name="help_strict_body">किसी सेशन या रूटीन के लिए सख़्त मोड चालू करें, तो उसके खत्म होने तक उसके ऐप्स अनलॉक नहीं हो सकते, सिवाय इमरजेंसी अनलॉक के। इसे बंद करने के लिए भी उसके अंत तक रुकना पड़ता है। सेटिंग › सख़्त मोड इसे हर नए सेशन और रूटीन के लिए चालू कर देता है।</string>
    <string name="help_billing">बिलिंग और Recentr Plus</string>
    <string name="help_billing_body">Recentr Plus की बिलिंग Google Play से होती है। आप सेटिंग › Recentr Plus या अपने Play सब्सक्रिप्शन से कभी भी रद्द कर सकते हैं।</string>
    <string name="help_note_section">हमें एक नोट भेजें</string>
    <string name="help_note_title">Recentr के लिए आइडिया</string>
