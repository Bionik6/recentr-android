    <!-- 67 · Settings — Help & feedback -->
    <string name="help_title">עזרה ומשוב</string>
    <string name="help_subtitle">אנחנו קוראים כל הודעה.</string>
    <string name="help_not_blocking">Recentr לא חוסמת אפליקציה</string>
    <string name="help_not_blocking_body">כדי לחסום צריך גישה לנתוני שימוש, ו-Recentr צריכה לפעול ברקע. כדאי לבדוק בהגדרות › אפליקציות › Recentr ולכבות את אופטימיזציית הסוללה.</string>
    <string name="help_strict">שאלות על מצב קפדני</string>
    <string name="help_strict_body">אחרי שמפעילים מצב קפדני לסשן או לשגרה, אי אפשר לפתוח את האפליקציות שלהם עד הסיום, מלבד בפתיחת חירום. גם כיבוי המצב ימתין לסיום. ההגדרה הכללית בהגדרות › מצב קפדני מפעילה אותו בכל סשן ושגרה חדשים.</string>
    <string name="help_billing">חיוב ו-Recentr Plus</string>
    <string name="help_billing_body">Recentr Plus מחויבת דרך Google Play. אפשר לבטל בכל עת דרך הגדרות › Recentr Plus או דרך המנויים שלך ב-Play.</string>
    <string name="help_note_section">שליחת הודעה אלינו</string>
    <string name="help_note_title">רעיון ל-Recentr</string>
    <string name="help_note_placeholder">היה מעולה סשן “לומדים עם חברים” שבו כולם ננעלים יחד.</string>
