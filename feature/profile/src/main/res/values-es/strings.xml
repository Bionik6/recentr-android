    <!-- 67 · Settings — Help & feedback -->
    <string name="help_title">Ayuda y comentarios</string>
    <string name="help_subtitle">Leemos cada mensaje.</string>
    <string name="help_not_blocking">Recentr no está bloqueando una app</string>
    <string name="help_not_blocking_body">El bloqueo necesita el acceso a datos de uso y que Recentr se ejecute en segundo plano. Revisa Configuración › Apps › Recentr y desactiva la optimización de batería.</string>
    <string name="help_strict">Preguntas sobre el modo estricto</string>
    <string name="help_strict_body">Activa el modo estricto en una sesión o rutina y, hasta que termine, sus apps no se pueden desbloquear, salvo con un desbloqueo de emergencia. Tampoco puedes desactivarlo hasta que acabe. En Configuración › Modo estricto se activa para todas las nuevas.</string>
    <string name="help_billing">Facturación y Recentr Plus</string>
    <string name="help_billing_body">Recentr Plus se factura a través de Google Play. Puedes cancelar cuando quieras desde Configuración › Recentr Plus o desde tus suscripciones de Play.</string>
    <string name="help_note_section">Envíanos una nota</string>
    <string name="help_note_title">Idea para Recentr</string>
