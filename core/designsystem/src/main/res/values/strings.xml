    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">Turn on app blocking</string>
    <string name="ds_blocking_body">To put the apps you block on hold, Recentr uses Android’s Accessibility service. It only sees which app you open — never what’s on your screen — and nothing leaves your phone.</string>
    <string name="ds_blocking_steps">In Settings › Accessibility, open “Recentr app blocking” (under Installed or Downloaded apps) and turn it on.</string>
    <string name="ds_blocking_open_settings">Open Settings</string>
    <string name="ds_blocking_not_now">Not now</string>
    <string name="ds_blocking_off_title">Blocking is off</string>
    <string name="ds_blocking_off_body">Turn it on so your rules and focus sessions put apps on hold.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Connect Recentr to Screen Time</string>
    <string name="ds_usage_access_body">Recentr needs Usage access to count your screen time, pickups and notifications. Everything stays on your phone.</string>
    <string name="ds_usage_access_connect">Connect</string>
