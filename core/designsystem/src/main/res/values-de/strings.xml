    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">App-Blockierung aktivieren</string>
    <string name="ds_blocking_body">Damit Recentr die Apps, die du blockierst, auf Eis legen kann, nutzt es den Bedienungshilfen-Dienst von Android. Er sieht nur, welche App du öffnest – nie, was auf deinem Bildschirm ist – und nichts verlässt dein Handy.</string>
    <string name="ds_blocking_steps">Öffne in den Einstellungen › Bedienungshilfen „Recentr App-Blocker“ (unter „Installierte Apps“ oder „Heruntergeladene Apps“) und schalte ihn ein.</string>
    <string name="ds_blocking_open_settings">Einstellungen öffnen</string>
    <string name="ds_blocking_not_now">Jetzt nicht</string>
    <string name="ds_blocking_off_title">Blockierung ist aus</string>
    <string name="ds_blocking_off_body">Schalte sie ein, damit deine Regeln und Fokus-Sitzungen Apps auf Eis legen.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Recentr mit der Bildschirmzeit verbinden</string>
    <string name="ds_usage_access_body">Recentr braucht den Zugriff auf Nutzungsdaten, um deine Bildschirmzeit, Pickups und Benachrichtigungen zu zählen. Alles bleibt auf deinem Handy.</string>
    <string name="ds_usage_access_connect">Verbinden</string>
