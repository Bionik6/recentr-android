    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">앱 차단 켜기</string>
    <string name="ds_blocking_body">차단한 앱을 일시 중지하기 위해 Recentr는 Android 접근성 서비스를 사용해요. 어떤 앱을 여는지만 확인할 뿐 화면에 보이는 내용은 절대 보지 않고, 어떤 정보도 휴대폰 밖으로 나가지 않아요.</string>
    <string name="ds_blocking_steps">설정 › 접근성에서 (설치된 앱 또는 다운로드한 앱 아래의) “Recentr 앱 차단”을 열고 켜 주세요.</string>
    <string name="ds_blocking_open_settings">설정 열기</string>
    <string name="ds_blocking_not_now">나중에</string>
    <string name="ds_blocking_off_title">차단이 꺼져 있어요</string>
    <string name="ds_blocking_off_body">규칙과 집중 세션이 앱을 일시 중지하도록 켜 주세요.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Recentr에 스크린 타임 연결하기</string>
    <string name="ds_usage_access_body">Recentr가 스크린 타임, 폰 확인 횟수, 알림 수를 집계하려면 사용 정보 접근 권한이 필요해요. 모든 정보는 휴대폰에만 저장돼요.</string>
