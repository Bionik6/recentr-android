    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">Zapni blokování aplikací</string>
    <string name="ds_blocking_body">K pozastavení aplikací, které blokuješ, využívá Recentr službu Přístupnost systému Android. Vidí jen to, kterou aplikaci otevřeš — nikdy ne to, co máš na obrazovce — a nic neopouští tvůj telefon.</string>
    <string name="ds_blocking_steps">V Nastavení › Přístupnost otevři „Blokování aplikací Recentr“ (v části Nainstalované nebo Stažené aplikace) a zapni ji.</string>
    <string name="ds_blocking_open_settings">Otevřít Nastavení</string>
    <string name="ds_blocking_not_now">Teď ne</string>
    <string name="ds_blocking_off_title">Blokování je vypnuté</string>
    <string name="ds_blocking_off_body">Zapni ho, aby tvá pravidla a sezení soustředění pozastavovala aplikace.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Připoj Recentr k času u obrazovky</string>
    <string name="ds_usage_access_body">Ke sledování času u obrazovky, zvednutí telefonu a oznámení potřebuje Recentr přístup k údajům o využití. Vše zůstává v tvém telefonu.</string>
    <string name="ds_usage_access_connect">Připojit</string>
