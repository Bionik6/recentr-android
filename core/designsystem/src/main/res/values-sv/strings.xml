    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">Slå på appblockering</string>
    <string name="ds_blocking_body">För att lägga appar du blockerar på is använder Recentr Androids tillgänglighetstjänst. Den ser bara vilken app du öppnar – aldrig vad som finns på skärmen – och inget lämnar din telefon.</string>
    <string name="ds_blocking_steps">Öppna ”Recentr appblockering” under Inställningar › Tillgänglighet (under Installerade appar eller Nedladdade appar) och slå på den.</string>
    <string name="ds_blocking_open_settings">Öppna Inställningar</string>
    <string name="ds_blocking_not_now">Inte nu</string>
    <string name="ds_blocking_off_title">Blockeringen är av</string>
    <string name="ds_blocking_off_body">Slå på den så att dina regler och fokussessioner lägger appar på is.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Koppla Recentr till skärmtid</string>
    <string name="ds_usage_access_body">Recentr behöver åtkomst till användningsdata för att räkna din skärmtid, dina upplockningar och aviseringar. Allt stannar på din telefon.</string>
