    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">Attiva il blocco delle app</string>
    <string name="ds_blocking_body">Per mettere in pausa le app che blocchi, Recentr usa il servizio di accessibilità di Android. Vede solo quale app apri — mai cosa c’è sul tuo schermo — e nulla lascia il tuo telefono.</string>
    <string name="ds_blocking_steps">In Impostazioni › Accessibilità, apri «Blocco app di Recentr» (in App installate o App scaricate) e attivalo.</string>
    <string name="ds_blocking_open_settings">Apri Impostazioni</string>
    <string name="ds_blocking_not_now">Non ora</string>
    <string name="ds_blocking_off_title">Il blocco è disattivato</string>
    <string name="ds_blocking_off_body">Attivalo perché le tue regole e sessioni focus mettano in pausa le app.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Collega Recentr a Tempo di utilizzo</string>
    <string name="ds_usage_access_body">Per contare il tuo tempo di utilizzo, le prese in mano e le notifiche, Recentr ha bisogno dell’accesso ai dati di utilizzo. Tutto resta sul tuo telefono.</string>
    <string name="ds_usage_access_connect">Collega</string>
