    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">فعّل حظر التطبيقات</string>
    <string name="ds_blocking_body">لتعليق التطبيقات التي تحظرها، يستخدم Recentr خدمة إمكانية الوصول في Android. لا يرى سوى التطبيق الذي تفتحه — وليس ما على شاشتك أبدًا — ولا يغادر أي شيء هاتفك.</string>
    <string name="ds_blocking_steps">في الإعدادات › إمكانية الوصول، افتح «حظر تطبيقات Recentr» (ضمن التطبيقات المثبّتة أو التي تم تنزيلها) ثم فعّله.</string>
    <string name="ds_blocking_open_settings">فتح الإعدادات</string>
    <string name="ds_blocking_not_now">ليس الآن</string>
    <string name="ds_blocking_off_title">الحظر متوقف</string>
    <string name="ds_blocking_off_body">فعّله لكي تعلّق قواعدك وجلسات التركيز التطبيقات.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">اربط Recentr بوقت الشاشة</string>
    <string name="ds_usage_access_body">يحتاج Recentr إلى إذن «الوصول إلى بيانات الاستخدام» لاحتساب وقت الشاشة وعمليات الالتقاط والإشعارات. كل شيء يبقى على هاتفك.</string>
    <string name="ds_usage_access_connect">ربط</string>
