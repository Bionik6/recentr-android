    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">Увімкни блокування додатків</string>
    <string name="ds_blocking_body">Щоб ставити заблоковані додатки на паузу, Recentr використовує службу спеціальних можливостей Android. Вона бачить лише, який додаток ти відкриваєш, — ніколи не вміст екрана — і нічого не залишає твій телефон.</string>
    <string name="ds_blocking_steps">Відкрий Налаштування › Спеціальні можливості, знайди «Блокування додатків Recentr» (у розділі «Установлені додатки» або «Завантажені додатки») і ввімкни його.</string>
    <string name="ds_blocking_open_settings">Відкрити налаштування</string>
    <string name="ds_blocking_not_now">Не зараз</string>
    <string name="ds_blocking_off_title">Блокування вимкнено</string>
    <string name="ds_blocking_off_body">Ввімкни його, щоб твої правила та сесії фокусу ставили додатки на паузу.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Підключи Recentr до екранного часу</string>
    <string name="ds_usage_access_body">Recentr потрібен доступ до даних про використання, щоб рахувати твій екранний час, підняття та сповіщення. Усе залишається на твоєму телефоні.</string>
    <string name="ds_usage_access_connect">Підключити</string>
