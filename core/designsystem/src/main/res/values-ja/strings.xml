    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">アプリのブロックをオンにする</string>
    <string name="ds_blocking_body">ブロックしたアプリを保留にするため、RecentrはAndroidのユーザー補助サービスを使います。確認するのは開いたアプリの名前だけで、画面の内容は一切見ません。データがスマホの外に出ることもありません。</string>
    <string name="ds_blocking_steps">「設定」›「ユーザー補助」で、「インストール済みアプリ」または「ダウンロード済みアプリ」にある「Recentrのアプリブロック」を開き、オンにしてください。</string>
    <string name="ds_blocking_open_settings">設定を開く</string>
    <string name="ds_blocking_not_now">今はしない</string>
    <string name="ds_blocking_off_title">ブロックがオフです</string>
    <string name="ds_blocking_off_body">オンにすると、ルールや集中セッションがアプリを保留にします。</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Recentrをスクリーンタイムに接続</string>
    <string name="ds_usage_access_body">スクリーンタイム、持ち上げ回数、通知を集計するには、「使用状況へのアクセス」が必要です。すべてスマホの中に保存されます。</string>
    <string name="ds_usage_access_connect">接続</string>
