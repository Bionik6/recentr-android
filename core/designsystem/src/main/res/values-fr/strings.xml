    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">Active le blocage des applis</string>
    <string name="ds_blocking_body">Pour mettre en veille les applis que tu bloques, Recentr utilise le service d’accessibilité d’Android. Il ne voit que l’appli que tu ouvres — jamais ce qu’il y a sur ton écran — et rien ne quitte ton téléphone.</string>
    <string name="ds_blocking_steps">Dans Paramètres › Accessibilité, ouvre « Blocage d’applis Recentr » (sous Applications installées ou téléchargées) et active-le.</string>
    <string name="ds_blocking_open_settings">Ouvrir les paramètres</string>
    <string name="ds_blocking_not_now">Pas maintenant</string>
    <string name="ds_blocking_off_title">Le blocage est désactivé</string>
    <string name="ds_blocking_off_body">Active-le pour que tes règles et tes sessions de concentration mettent les applis en veille.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Connecte Recentr au temps d’écran</string>
    <string name="ds_usage_access_body">Recentr a besoin de l’accès aux données d’utilisation pour compter ton temps d’écran, tes prises en main et tes notifications. Tout reste sur ton téléphone.</string>
    <string name="ds_usage_access_connect">Connecter</string>
