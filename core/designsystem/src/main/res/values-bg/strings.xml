    <!-- App blocking (Accessibility service) -->
    <string name="ds_blocking_title">Включи блокирането на приложения</string>
    <string name="ds_blocking_body">За да постави блокираните приложения на изчакване, Recentr използва услугата за достъпност на Android. Тя вижда само кое приложение отваряш — никога какво има на екрана ти — и нищо не напуска телефона ти.</string>
    <string name="ds_blocking_steps">В Настройки › Достъпност отвори „Блокиране на приложения от Recentr“ (в „Инсталирани приложения“ или „Изтеглени приложения“) и го включи.</string>
    <string name="ds_blocking_open_settings">Отвори настройките</string>
    <string name="ds_blocking_not_now">Не сега</string>
    <string name="ds_blocking_off_title">Блокирането е изключено</string>
    <string name="ds_blocking_off_body">Включи го, за да поставят правилата и фокус сесиите ти приложения на изчакване.</string>

    <!-- Screen time (Usage access) -->
    <string name="ds_usage_access_title">Свържи Recentr с екранното време</string>
    <string name="ds_usage_access_body">Recentr се нуждае от достъп до данни за използване, за да отчита екранното ти време, вдигането на телефона и известията. Всичко остава на телефона ти.</string>
    <string name="ds_usage_access_connect">Свържи</string>
